# Como subir os dados. Ver a seção "Dados" do README.
#   existing_db  -> banco já rodando e importado; o pipeline só conecta (DEFAULT aqui)
#   local        -> pasta com o dump já extraído; compose sobe o banco e importa
#   download     -> baixa o zip do Zenodo, extrai e importa
DATASET_SOURCE=existing_db

# Usado nos modos local/download. Caminho ABSOLUTO da pasta que contém `msr14-mysql`.
# O pipeline monta esse arquivo read-only; nunca escreve nada dentro dessa pasta.
DATASET_DIR=/Users/wendell.oliveira/Downloads/268528

# Conexão. No modo existing_db aponta pro container `msr14` que já está de pé.
# No modo local/download o compose sobe o banco dele na 3307 pra não colidir.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=msr14

LOG_LEVEL=INFO
